# ── Database (Supabase) ───────────────────────────────────────
DATABASE_URL=postgresql://...                    # pgBouncer pooler (port 6543) — app runtime
DATABASE_URL_DIRECT=postgresql://...             # session pooler (port 5432) — migrations

# ── Auth / Email ──────────────────────────────────────────────
SESSION_SECRET=...                               # 96-char hex
RESEND_API_KEY=re_...                            # Resend transactional email
APP_URL=https://filamentos.app                   # magic link redirect base

# ── AI (Phase 4 — project parser) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                     # Used for project component extraction (Phase 4)

# ── Affiliate tags (Phase 4 — buy links) ──────────────────────
# Leave empty until enrolled — buy links still work without them
AMAZON_AFFILIATE_TAG=
BAMBU_AFFILIATE_ID=
ALIEXPRESS_AFFILIATE_KEY=
