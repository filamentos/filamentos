# ─────────────────────────────────────────────────────────────
# FilamentOS — Environment Variables
#
# For local dev: copy this file to .env and fill in values.
#
# For production (Vercel): set ALL variables below in the
# Vercel dashboard under Project → Settings → Environment Variables.
# Do NOT commit .env to git.
# ─────────────────────────────────────────────────────────────

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Auth / Email
RESEND_API_KEY=re_...
APP_URL=https://filamentos.app   # set to your Vercel deployment URL in production
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# AI — Claude API (Phase 4 — project URL parser)
ANTHROPIC_API_KEY=sk-ant-...

# Affiliate tags
AMAZON_AFFILIATE_TAG=filamentos-20
BAMBU_AFFILIATE_ID=
ALIEXPRESS_AFFILIATE_KEY=

# Feature flags
INVITE_ONLY=true
ENABLE_PROJECT_PARSER=false
ENABLE_STRIPE=false
ENABLE_QUOTE_ENGINE=true
